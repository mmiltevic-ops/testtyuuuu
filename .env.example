# Скопируйте этот файл в .env и подставьте свои значения
# cp .env.example .env

# --- Сервер ---
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autoservice

# Если база недоступна, сайт показывает демо-данные (true/false)
DEMO_FALLBACK=true

# --- Админ-панель ---
# Используется, если в таблице admin_users нет пользователей
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
