<%- include('partials/header') %>

<main>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Как нас найти</span>
      <h1>Контакты</h1>
      <p class="lead">Мы в 7 минутах от метро «Автозаводская». Есть парковка для клиентов и зона ожидания с кофе.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container contacts">
      <div class="card-panel">
        <h3>Автосервис «ТурбоДоктор»</h3>
        <ul class="contact-list">
          <li>
            <span>Адрес</span>
            <b>Москва, ул. Автозаводская, 18, стр. 2</b>
          </li>
          <li>
            <span>Телефон</span>
            <b><a href="tel:+74951234567">+7 (495) 123-45-67</a></b>
          </li>
          <li>
            <span>E-mail</span>
            <b><a href="mailto:service@turbodoktor.ru">service@turbodoktor.ru</a></b>
          </li>
          <li>
            <span>Режим работы</span>
            <b>Пн–Вс, 09:00–21:00</b>
          </li>
          <li>
            <span>Реквизиты</span>
            <b>ООО «ТурбоДоктор», ИНН 7712345678</b>
          </li>
        </ul>
        <a class="btn btn--accent btn--lg" href="/booking">Записаться на ремонт</a>
      </div>

      <div class="map-card">
        <div class="map-card__pin">
          <svg class="ico"><use href="#icon-body" /></svg>
          <span>Автозаводская, 18</span>
        </div>
        <p class="map-card__hint">
          Схема проезда: въезд с улицы Автозаводской, после шлагбаума — налево, бокс №3.
